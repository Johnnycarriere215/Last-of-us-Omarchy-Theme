# Theme: Last of Us
# Survival / firefly amber palette

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#12140e"

# Main text color
theme[main_fg]="#cec9bd"

# Title color for boxes
theme[title]="#c9803a"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e0a04f"

# Background color of selected item in processes box
theme[selected_bg]="#3a3d30"

# Foreground color of selected item in processes box
theme[selected_fg]="#e0a04f"

# Color of inactive/disabled text
theme[inactive_fg]="#5a5d4c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#8a9a63"

# Box outline and divider line color
theme[cpu_box]="#3a3d30"
theme[mem_box]="#3a3d30"
theme[net_box]="#3a3d30"
theme[proc_box]="#3a3d30"
theme[div_line]="#3a3d30"

# Temperature gradient (low -> mid -> high)
theme[temp_start]="#6d7d4e"
theme[temp_mid]="#c9803a"
theme[temp_end]="#a44a3f"

# CPU meter gradient
theme[cpu_start]="#6d7d4e"
theme[cpu_mid]="#c9803a"
theme[cpu_end]="#a44a3f"

# Free memory gradient
theme[free_start]="#8a9a63"
theme[free_mid]="#6d7d4e"
theme[free_end]="#4f6b74"

# Cached memory gradient
theme[cached_start]="#7d97a1"
theme[cached_mid]="#4f6b74"
theme[cached_end]="#6f8b86"

# Available memory gradient
theme[available_start]="#e0a04f"
theme[available_mid]="#c9803a"
theme[available_end]="#a44a3f"

# Used memory gradient
theme[used_start]="#8a9a63"
theme[used_mid]="#c9803a"
theme[used_end]="#c26350"

# Download graph gradient
theme[download_start]="#4f6b74"
theme[download_mid]="#6f8b86"
theme[download_end]="#8fa9a3"

# Upload graph gradient
theme[upload_start]="#a44a3f"
theme[upload_mid]="#c9803a"
theme[upload_end]="#e0a04f"

# Process box color gradient
theme[process_start]="#6d7d4e"
theme[process_mid]="#c9803a"
theme[process_end]="#a44a3f"
